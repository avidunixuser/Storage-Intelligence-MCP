ess to Function tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=66;fontFamily=Segoe UI;fontSize=12;fontStyle=0;fillColor=#edf9f3;strokeColor=#25855a;shape=label;image=data:image/svg+xml;base64,;imageWidth=42;imageHeight=42;imageAlign=left;imageVerticalAlign=middle;spacing=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="715" y="875" width="355" height="110" as="geometry"/></mxCell><mxCell id="webmi" value="&lt;b&gt;Web user-assigned managed identity&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;Cosmos database-scoped data contributor&lt;br&gt;Foundry User + AcrPull + Function Website Contributor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=66;fontFamily=Segoe UI;fontSize=12;fontStyle=0;fillColor=#f1f8ff;strokeColor=#2674b8;shape=label;image=data:image/svg+xml;base64,;imageWidth=42;imageHeight=42;imageAlign=left;imageVerticalAlign=middle;spacing=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1165" y="745" width="565" height="105" as="geometry"/></mxCell><mxCell id="funcmi" value="&lt;b&gt;Function user-assigned managed identity&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;Blob Owner/Contributor + Queue/Table Contributor&lt;br&gt;Key Vault Secrets User + Durable Task Contributor&lt;br&gt;Monitoring Metrics Publisher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;align=left;verticalAlign=middle;spacingLeft=66;fontFamily=Segoe UI;fontSize=12;fontStyle=0;fillColor=#f6f2ff;strokeColor=#7252aa;shape=label;image=data:image/svg+xml;base64,;imageWidth=42;imageHeight=42;imageAlign=left;imageVerticalAlign=middle;spacing=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1165" y="870" width="565" height="125" as="geometry"/></mxCell><mxCell id="edge-1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078d4;strokeWidth=3;endArrow=block;dashed=0;fontFamily=Segoe UI